<!DOCTYPE html>
<html>

<head>

    <title>British Values</title>

    <style>

        /* This changes the whole page */
        body {
            margin: 0;
            background-color: black;
            font-family: Arial;
        }

        /* This is the main website */
        .page {
            width: 410px;
            margin: auto;
            background-color: black;
        }

        /* Top part of the website */
        .header {
            height: 105px;
            border-bottom: 3px solid #00a6a6;
            position: relative;
        }

        /* Logo on the left */
        .logo {
            width: 105px;
            height: 98px;
            margin-left: 8px;
            margin-top: 3px;
        }

        /* Union Jack on the right */
        .flag {
            width: 123px;
            height: 100px;
            position: absolute;
            right: 5px;
            top: 2px;
        }

        /* Navigation bar */
        .navigation {
            height: 43px;
            background-color: #aaaaaa;
            border-bottom: 2px solid black;
            display: flex;
        }

        /* Navigation buttons */
        .navigation a {
            color: black;
            text-decoration: none;
            font-size: 17px;
            padding: 12px 15px;
        }

        /* Hover effect */
        .navigation a:hover {
            background-color: #777777;
            color: white;
        }

        /* Line underneath navigation */
        .line {
            width: 90%;
            height: 2px;
            background-color: #00a6a6;
            margin: 10px auto;
        }

        /* First section */
        .top-section {
            display: flex;
            margin-top: 10px;
        }

        .top-section img {
            width: 52%;
            height: 122px;
            object-fit: cover;
        }

        .top-text {
            width: 48%;
            color: #00cccc;
            font-size: 11px;
            text-align: center;
            padding: 10px 5px;
            box-sizing: border-box;
        }

        /* Second section */
        .bottom-section {
            display: flex;
            margin-top: 38px;
        }

        .bottom-section img {
            width: 51%;
            height: 193px;
            object-fit: cover;
        }

        .bottom-text {
            width: 49%;
            color: white;
            border: 2px solid #777777;
            font-size: 12px;
            text-align: center;
            padding: 12px 7px;
            box-sizing: border-box;
        }

        /* Footer */
        .footer {
            color: white;
            text-align: center;
            font-size: 12px;
            padding: 20px;
        }

    </style>

</head>


<body>

    <div class="page">

        <!-- Header -->
        <div class="header">

            <img class="logo" src="images/logo.png">

            <img class="flag" src="images/uk-flag.png">

        </div>


        <!-- Navigation -->
        <div class="navigation">

            <a href="index.html">Home</a>

            <a href="about.html">About us</a>

            <a href="gallery.html">Gallery</a>

        </div>


        <!-- Teal line -->
        <div class="line"></div>


        <!-- First section -->
        <div class="top-section">

            <img src="images/values-flag.png">

            <div class="top-text">

                <h3>British Values</h3>

                <p>
                    British values are important values
                    that help people live together fairly
                    and respectfully.
                </p>

            </div>

        </div>


        <!-- Second section -->
        <div class="bottom-section">

            <img src="images/icons-england.png">

            <div class="bottom-text">

                <h3>Our Values</h3>

                <p>
                    The main British values include
                    democracy, the rule of law,
                    individual liberty, and mutual
                    respect and tolerance.
                </p>

            </div>

        </div>


        <!-- Footer -->
        <div class="footer">

            <p>British Values Website</p>

        </div>

    </div>

</body>

</html>